{
  "scripts": {
    "start": "npm run start:server",
    "start:server_image": "start npm run start:frp_tcp & node main.js image",
    "start:server_esp32": "start npm run start:frp_tcp & start npm run start:frp_udp & node main.js esp32",
    "start:frp_tcp": ".\\frp\\frpc.exe -c .\\frp\\frpc_tcp.ini",
    "start:frp_udp": ".\\frp\\frpc.exe -c .\\frp\\frpc_udp.ini",
    "fmt:server": "prettier --write **/*.js",
    "fmt:python": "black .",
    "dev:frontend": "cd frontend && max dev",
    "build:frontend": "cd frontend && max build",
    "preview:frontend": "cd frontend && max preview --port 8000",
    "biome:frontend": "biome lint frontend",
    "tsc:frontend": "tsc --noEmit -p tsconfig.json",
    "lint:frontend": "npm run biome:frontend && npm run tsc:frontend",
    "fmt:frontend": "biome format frontend --write",
    "fmt": "npm run fmt:server && npm run fmt:python && npm run fmt:frontend"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "antd": "^5.25.4",
    "dgram": "^1.0.1",
